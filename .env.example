# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values you have.
# The storefront runs without any of these (it uses seed data).
# Each block below unlocks one feature.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin panel (/admin) --------------------------------------------------
# Any strong string. You log in with this password.
ADMIN_PASSWORD=change-me
# Random 32+ char string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=generate-a-long-random-string-here

# --- Firebase (Firestore) — persists products, settings, orders -----------
# From Firebase console > Project settings > Service accounts > Generate key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole private key in quotes, keep the \n escapes.
FIREBASE_PRIVATE_KEY=""

# --- Instagram (Instagram API with Instagram Login) ----------------------
# Meta app (developers.facebook.com) with the "Instagram" product added.
# Your IG account must be Business or Creator.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match a redirect URI whitelisted in the Meta app.
# Instagram requires HTTPS — for local dev use an ngrok/cloudflared tunnel.
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# Secret Vercel Cron uses to call /api/cron/sync-instagram once a day (see
# vercel.json). Any random string — Vercel sends it back as a Bearer token
# automatically once this env var is set on the project.
CRON_SECRET=

# --- Razorpay ------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID — exposed to the browser for Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Optional: set if you configure a Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=
